<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SIKOPY"
             x:Class="SIKOPY.App"
             RequestedThemeVariant="Light">
             <!-- The SIKOPI design only defines light colors, so the app stays in the light theme. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ===== Text ===== -->
        <Style Selector="TextBlock.tableHeader">
            <Setter Property="Foreground" Value="#718279" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="#475C50" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.formError">
            <Setter Property="Foreground" Value="#C63D34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ===== Primary button (dark green) ===== -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1F5A49" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2D614E" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#183B32" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#9DB3A8" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- ===== Danger button ===== -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#C63D34" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A8322A" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8E2A23" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- ===== Secondary button (outlined) ===== -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#183B32" />
            <Setter Property="BorderBrush" Value="#DCE5DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F3F6F2" />
            <Setter Property="BorderBrush" Value="#C9D6CB" />
            <Setter Property="Foreground" Value="#183B32" />
        </Style>
        <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E6EDE6" />
            <Setter Property="Foreground" Value="#183B32" />
        </Style>

        <!-- ===== Small square icon button (row actions) ===== -->
        <Style Selector="Button.iconAction">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#EDF4ED" />
            <Setter Property="Foreground" Value="#2D614E" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.iconAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCEBDD" />
            <Setter Property="Foreground" Value="#183B32" />
        </Style>
        <Style Selector="Button.iconAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CFE2D1" />
            <Setter Property="Foreground" Value="#183B32" />
        </Style>

        <!-- ===== Form inputs ===== -->
        <Style Selector="TextBox.field">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#DCE5DC" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#183B32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#2D614E" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="ComboBox.field">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#DCE5DC" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#183B32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="CalendarDatePicker.field">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#DCE5DC" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#183B32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>
