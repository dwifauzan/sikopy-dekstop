<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SIKOPY.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
             x:Class="SIKOPY.Views.ForgotPasswordView"
             x:DataType="vm:ForgotPasswordViewModel"
             Background="{StaticResource ForgotWindowBackground}">
    <Design.DataContext>
        <vm:ForgotPasswordViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="ForgotWindowBackground" Color="#F4F1EB" />
        <SolidColorBrush x:Key="ForgotBrandPanelBackground" Color="#183B32" />
        <SolidColorBrush x:Key="ForgotAccentBadgeBackground" Color="#E7D9BF" />
        <SolidColorBrush x:Key="ForgotCardSurfaceBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ForgotHeadingForeground" Color="#183B32" />
        <SolidColorBrush x:Key="ForgotPrimaryForeground" Color="#1F5A49" />
        <SolidColorBrush x:Key="ForgotMutedForeground" Color="#718279" />
        <SolidColorBrush x:Key="ForgotBorderBrush" Color="#DCE5DC" />
        <SolidColorBrush x:Key="ForgotHoverSurfaceBrush" Color="#F3F6F2" />
        <SolidColorBrush x:Key="ForgotPressedSurfaceBrush" Color="#E6EDE6" />
        <SolidColorBrush x:Key="ForgotErrorSurfaceBrush" Color="#FDF2F2" />
        <SolidColorBrush x:Key="ForgotErrorBorderBrush" Color="#F5D0CE" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.eyeToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.eyeToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ForgotHoverSurfaceBrush}" />
        </Style>
        <Style Selector="Button.eyeToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ForgotPressedSurfaceBrush}" />
        </Style>
        <Style Selector="Button.eyeToggle Path">
            <Setter Property="Stroke" Value="{StaticResource ForgotMutedForeground}" />
            <Setter Property="StrokeThickness" Value="1.75" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Button.eyeToggle:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource ForgotHeadingForeground}" />
        </Style>

        <Style Selector="Button.accentLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ForgotPrimaryForeground}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.accentLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.accentLink:pointerover">
            <Setter Property="Foreground" Value="{StaticResource ForgotHeadingForeground}" />
        </Style>
    </UserControl.Styles>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <Border Width="760"
                MinHeight="440"
                CornerRadius="16"
                ClipToBounds="True"
                BorderBrush="{StaticResource ForgotBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 14 36 0 #1A183B32">
            <Grid ColumnDefinitions="270,*">
                <!-- ===== Panel Kiri (Area Branding) ===== -->
                <Border Grid.Column="0"
                        Background="{StaticResource ForgotBrandPanelBackground}"
                        Padding="32">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="{StaticResource ForgotAccentBadgeBackground}"
                                    CornerRadius="8"
                                    Width="36"
                                    Height="36">
                                <PathIcon Data="{StaticResource IconCoffee}"
                                          Width="19"
                                          Height="19"
                                          Foreground="{StaticResource ForgotBrandPanelBackground}" />
                            </Border>
                            <TextBlock Text="SIKOPI"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       LetterSpacing="1.4"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="Ruang kerja&#10;roastery."
                                   FontFamily="Georgia, Times New Roman, Serif"
                                   FontSize="26"
                                   LineHeight="34"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />
                    </Grid>
                </Border>

                <!-- ===== Panel Kanan (Area Form Ubah Password) ===== -->
                <Border Grid.Column="1"
                        Background="{StaticResource ForgotCardSurfaceBackground}"
                        Padding="44,34">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ubah Password"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ForgotHeadingForeground}" />
                        <TextBlock Margin="0,4,0,20"
                                   Text="Masukkan username dan password baru Anda"
                                   FontSize="13"
                                   Foreground="{StaticResource ForgotMutedForeground}" />

                        <!-- Input Username -->
                        <TextBlock Classes="fieldLabel" Text="Username" />
                        <TextBox Classes="field"
                                 Height="42"
                                 Margin="0,0,0,14"
                                 PlaceholderText="Nama pengguna"
                                 MaxLength="50"
                                 Text="{Binding Username, Mode=TwoWay}"
                                 IsEnabled="{Binding !IsLoading}" />

                        <!-- Input Password Baru -->
                        <TextBlock Classes="fieldLabel" Text="Password Baru" />
                        <TextBox Classes="field"
                                 Height="42"
                                 Margin="0,0,0,14"
                                 PlaceholderText="Minimal 6 karakter"
                                 PasswordChar="{Binding NewPasswordChar}"
                                 Text="{Binding NewPassword, Mode=TwoWay}"
                                 IsEnabled="{Binding !IsLoading}">
                            <TextBox.InnerRightContent>
                                <Button Classes="eyeToggle"
                                        Command="{Binding ToggleNewPasswordVisibilityCommand}"
                                        Focusable="False"
                                        ToolTip.Tip="Tampilkan / sembunyikan password baru">
                                    <Panel>
                                        <Viewbox Width="16" Height="16" IsVisible="{Binding !IsNewPasswordVisible}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0 M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox Width="16" Height="16" IsVisible="{Binding IsNewPasswordVisible}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49 M14.084 14.158a3 3 0 0 1-4.242-4.242 M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143 M2 2l20 20" />
                                            </Canvas>
                                        </Viewbox>
                                    </Panel>
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <!-- Input Konfirmasi Password Baru -->
                        <TextBlock Classes="fieldLabel" Text="Konfirmasi Password Baru" />
                        <TextBox Classes="field"
                                 Height="42"
                                 PlaceholderText="Ulangi password baru"
                                 PasswordChar="{Binding ConfirmPasswordChar}"
                                 Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                 IsEnabled="{Binding !IsLoading}">
                            <TextBox.InnerRightContent>
                                <Button Classes="eyeToggle"
                                        Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                                        Focusable="False"
                                        ToolTip.Tip="Tampilkan / sembunyikan konfirmasi password">
                                    <Panel>
                                        <Viewbox Width="16" Height="16" IsVisible="{Binding !IsConfirmPasswordVisible}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0 M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox Width="16" Height="16" IsVisible="{Binding IsConfirmPasswordVisible}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49 M14.084 14.158a3 3 0 0 1-4.242-4.242 M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143 M2 2l20 20" />
                                            </Canvas>
                                        </Viewbox>
                                    </Panel>
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <!-- Pesan Error -->
                        <Border Margin="0,12,0,0"
                                Padding="12,9"
                                CornerRadius="8"
                                Background="{StaticResource ForgotErrorSurfaceBrush}"
                                BorderBrush="{StaticResource ForgotErrorBorderBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding HasError}">
                            <TextBlock Classes="formError" Text="{Binding ErrorMessage}" />
                        </Border>

                        <!-- Tombol Simpan -->
                        <Button Classes="primary"
                                Margin="0,20,0,0"
                                Height="44"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontWeight="SemiBold"
                                IsDefault="True"
                                Command="{Binding ResetPasswordCommand}">
                            <Panel>
                                <TextBlock Text="Simpan Password" IsVisible="{Binding !IsLoading}" />
                                <TextBlock Text="Memproses..." IsVisible="{Binding IsLoading}" />
                            </Panel>
                        </Button>

                        <!-- Navigasi Kembali ke Login -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="4"
                                    Margin="0,16,0,0">
                            <TextBlock Text="Ingat password Anda?"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ForgotMutedForeground}" />
                            <Button Classes="accentLink"
                                    Content="Kembali ke Masuk"
                                    VerticalAlignment="Center"
                                    Command="{Binding NavigateToLoginCommand}"
                                    IsEnabled="{Binding !IsLoading}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
