<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SIKOPY.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
             x:Class="SIKOPY.Views.ForgotPasswordView"
             x:DataType="vm:ForgotPasswordViewModel"
             Background="{StaticResource ForgotWindowBackground}">
    <Design.DataContext>
        <vm:ForgotPasswordViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="ForgotWindowBackground" Color="#F4F1EB" />
        <SolidColorBrush x:Key="ForgotBrandPanelBackground" Color="#183B32" />
        <SolidColorBrush x:Key="ForgotAccentBadgeBackground" Color="#E7D9BF" />
        <SolidColorBrush x:Key="ForgotCardSurfaceBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ForgotHeadingForeground" Color="#183B32" />
        <SolidColorBrush x:Key="ForgotPrimaryForeground" Color="#1F5A49" />
        <SolidColorBrush x:Key="ForgotMutedForeground" Color="#718279" />
        <SolidColorBrush x:Key="ForgotBorderBrush" Color="#DCE5DC" />
    </UserControl.Resources>


    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <Border Width="760"
                MinHeight="440"
                CornerRadius="16"
                ClipToBounds="True"
                BorderBrush="{StaticResource ForgotBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 14 36 0 #1A183B32">
            <Grid ColumnDefinitions="270,*">
                <!-- ===== Panel Kiri (Area Branding) ===== -->
                <Border Grid.Column="0"
                        Background="{StaticResource ForgotBrandPanelBackground}"
                        Padding="32">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="{StaticResource ForgotAccentBadgeBackground}"
                                    CornerRadius="8"
                                    Width="36"
                                    Height="36">
                                <PathIcon Data="{StaticResource IconCoffee}"
                                          Width="19"
                                          Height="19"
                                          Foreground="{StaticResource ForgotBrandPanelBackground}" />
                            </Border>
                            <TextBlock Text="SIKOPI"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       LetterSpacing="1.4"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="Ruang kerja&#10;roastery."
                                   FontFamily="Georgia, Times New Roman, Serif"
                                   FontSize="26"
                                   LineHeight="34"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />
                    </Grid>
                </Border>

                <!-- ===== Panel Kanan ===== -->
                <!-- Reset mandiri dihapus: siapa pun bisa mengganti password akun lain hanya dengan username. -->
                <Border Grid.Column="1"
                        Background="{StaticResource ForgotCardSurfaceBackground}"
                        Padding="44,34">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lupa Password"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ForgotHeadingForeground}" />
                        <TextBlock Margin="0,8,0,24"
                                   Text="Demi keamanan akun, password hanya bisa direset oleh admin. Hubungi admin roastery dan sebutkan username Anda."
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{StaticResource ForgotMutedForeground}" />

                        <Button Classes="primary"
                                Height="44"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontWeight="SemiBold"
                                IsDefault="True"
                                Content="Kembali ke Masuk"
                                Command="{Binding NavigateToLoginCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
