<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SIKOPY.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="SIKOPY.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#F4F1EB">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.navItem">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#183B32" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Border.navItem:pointerover">
            <Setter Property="Background" Value="#20483C" />
        </Style>
        <Style Selector="Border.navItem.active, Border.navItem.active:pointerover">
            <Setter Property="Background" Value="#2D614E" />
        </Style>
        <Style Selector="Border.navItem PathIcon">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Foreground" Value="#ABC5B4" />
        </Style>
        <Style Selector="Border.navItem TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#D4E1D7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.navItem.active PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.navItem.active TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="248,*">
        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="#183B32" Padding="20,30,20,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="#E7D9BF" CornerRadius="11" Width="42" Height="42">
                            <PathIcon Data="{StaticResource IconCoffee}" Width="22" Height="22"
                                      Foreground="#183B32" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="SIKOPI" Foreground="White" FontSize="15"
                                       FontWeight="Bold" LetterSpacing="0.4" />
                            <TextBlock Text="Roastery" Foreground="#B9CFC1" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,56,0,14" Text="MENU" Foreground="#95B4A2"
                               FontSize="11" FontWeight="Bold" LetterSpacing="1.5" />

                    <!-- Only Bahan Baku is built so far; the other screens will plug in here. -->
                    <Border Classes="navItem" ToolTip.Tip="Segera hadir">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Data="{StaticResource IconDashboard}" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </Border>
                    <Border Classes="navItem active">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Data="{StaticResource IconPackage}" />
                            <TextBlock Text="Bahan Baku" />
                        </StackPanel>
                    </Border>
                    <Border Classes="navItem" ToolTip.Tip="Segera hadir">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Data="{StaticResource IconFlame}" />
                            <TextBlock Text="Batch Roasting" />
                        </StackPanel>
                    </Border>
                    <Border Classes="navItem" ToolTip.Tip="Segera hadir">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Data="{StaticResource IconStore}" />
                            <TextBlock Text="Etalase" />
                        </StackPanel>
                    </Border>
                    <Border Classes="navItem" ToolTip.Tip="Segera hadir">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Data="{StaticResource IconHistory}" />
                            <TextBlock Text="Riwayat" />
                        </StackPanel>
                    </Border>
                    <Border Classes="navItem" ToolTip.Tip="Segera hadir">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Data="{StaticResource IconUsers}" />
                            <TextBlock Text="Pengguna" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Account (pinned to the bottom) -->
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border Height="1" Background="#416555" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Height="68">
                        <Border Background="#E7D9BF" CornerRadius="19" Width="38" Height="38">
                            <TextBlock Text="A" Foreground="#183B32" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Admin Roastery" Foreground="White" FontSize="13" />
                            <TextBlock Text="Admin" Foreground="#A9C5B2" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Current screen ===== -->
        <ContentControl Grid.Column="1" Content="{Binding RawMaterials}" />
    </Grid>
</UserControl>
