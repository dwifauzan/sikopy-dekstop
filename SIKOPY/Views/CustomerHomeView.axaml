<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SIKOPY.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
             x:Class="SIKOPY.Views.CustomerHomeView"
             x:DataType="vm:CustomerHomeViewModel">
    <Design.DataContext>
        <vm:CustomerHomeViewModel />
    </Design.DataContext>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="480">
        <PathIcon Data="{StaticResource IconStore}" Width="40" Height="40" Foreground="#183B32" />
        <TextBlock Text="{Binding Greeting}" FontSize="24" FontWeight="Bold" Foreground="#183B32"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Etalase untuk pelanggan segera hadir."
                   FontSize="14" Foreground="#718279" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
</UserControl>
